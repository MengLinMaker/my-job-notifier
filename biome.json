{
    "$schema": "https://biomejs.dev/schemas/2.4.6/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "lineWidth": 100,
        "indentWidth": 4
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "useLiteralKeys": "off"
            },
            "suspicious": {
                "noUnknownAtRules": "off",
                "noTsIgnore": "off",
                "noAssignInExpressions": "off",
                "noExplicitAny": "off"
            },
            "style": {
                "noNonNullAssertion": "off",
                "useTemplate": "off"
            },
            "a11y": {
                "noStaticElementInteractions": "off"
            }
        }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "javascript": {
        "formatter": {
            "semicolons": "asNeeded",
            "quoteStyle": "single"
        }
    },
    "files": {
        "maxSize": 10000000,
        "includes": [
            "**/*",
            "!**/coverage",
            "!**/dist",
            "!**/node_modules",
            "!**/cdk.out",
            "!**/src/routeTree.gen.ts",
            "!**/coverage",
            "!**/.output"
        ],
        "ignoreUnknown": true
    },
    "assist": {
        "enabled": false
    }
}
