{
    "private": true,
    "scripts": {
        "secure": "pnpm audit --fix=update",
        "format": "biome format --write",
        "knip": "knip",
        "lint": "biome lint --write && jscpd",
        "postinstall": "simple-git-hooks",
        "preinstall": "npx only-allow pnpm",
        "test": "pnpm --filter '...[origin/main]' '/test:(type|lint|unit)/'"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.6",
        "@pulumi/pulumi": "^3.227.0",
        "@types/node": "*",
        "@typescript/native-preview": "7.0.0-dev.20260201.1",
        "@vitest/coverage-v8": "4.1.0",
        "concurrently": "^9.2.1",
        "jscpd": "^4.0.7",
        "knip": "5.63.1",
        "simple-git-hooks": "2.13.1",
        "typescript": "~6.0.3",
        "vite": "8.0.10",
        "vitest": "4.1.0"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm concurrently --kill-others-on-fail --success all \"pnpm format\" \"pnpm lint\" \"pnpm secure:high --audit-level high\""
    },
    "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
    "type": "module"
}
